  let gv := harmListKevShift 0 ev ev harmBlks + harmListKevShift ev 0 ev harmBlks + harmListKevShift ev ev 0 harmBlks
  let gt := harmListEvZ 1 (7 : Int) (7 : Int) harmBlks + harmListEvZ (7 : Int) 1 (7 : Int) harmBlks + harmListEvZ (7 : Int) (7 : Int) 1 harmBlks
