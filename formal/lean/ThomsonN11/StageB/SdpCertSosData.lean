  blk.e1.toList.all (fun p => p.all (fun x => decide (x.2.1 ≤ db ∧ x.2.2.1 ≤ db ∧ x.2.2.2 ≤ db))) &&
  blk.e2.toList.all (fun p => p.all (fun x => decide (x.2.1 ≤ db ∧ x.2.2.1 ≤ db ∧ x.2.2.2 ≤ db)))

